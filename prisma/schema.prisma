generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* ---------- MODELS ---------- */

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique @db.Text
  // NEW FIELDS (nullable for a safe, first migration)
  passwordHash  String?  @map("password_hash") @db.Text
  displayName   String?  @map("display_name")  @db.Text
  timezone      String   @default("Asia/Kolkata") @db.Text
  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamptz(6)

  createdAt     DateTime @default(now())        @db.Timestamptz(6) @map("created_at")
  updatedAt     DateTime @updatedAt             @db.Timestamptz(6) @map("updated_at")

  streaks       Streak[]

  @@map("users")
}


model Streak {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid             @map("user_id")
  name      String   @db.Text
  startDate DateTime @db.Date             @map("start_date")
  endDate   DateTime @db.Date             @map("end_date")
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6)     @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  goals  Goal[]

  @@index([userId], map: "streaks_user_id_idx")
  @@map("streaks")
}

model Goal {
  id            String   @id @default(uuid()) @db.Uuid
  streakId      String   @db.Uuid             @map("streak_id")
  name          String   @db.Text
  // Keep TEXT in DB (not a PG enum) to match your spec; we'll add a CHECK via raw SQL in the migration.
  type          String   @db.Text
  unit          String?  @db.Text
  perDayTarget  Decimal? @db.Decimal(10, 2)   @map("per_day_target")
  createdAt     DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)     @map("updated_at")

  streak      Streak    @relation(fields: [streakId], references: [id], onDelete: Cascade)
  logEntries  LogEntry[]

  @@index([streakId], map: "goals_streak_id_idx")
  @@map("goals")
}

model LogEntry {
  id        String   @id @default(uuid()) @db.Uuid
  goalId    String   @db.Uuid             @map("goal_id")
  localDate DateTime @db.Date             @map("local_date")
  value     Decimal? @db.Decimal(10, 2)
  done      Boolean?
  // Enforce ≤ 280 at DB level using VARCHAR(280)
  note      String?  @db.VarChar(280)
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  editedAt  DateTime? @db.Timestamptz(6)                @map("edited_at")

  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, localDate], map: "log_entries_goal_id_local_date_key")
  @@index([goalId], map: "log_entries_goal_id_idx")
  @@map("log_entries")
}
